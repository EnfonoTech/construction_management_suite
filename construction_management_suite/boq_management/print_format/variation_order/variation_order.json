 "doctype": "Print Format",
 "font_size": 0,
 "html": "<style>\n  .cms-doc { font-family: \"Helvetica Neue\", Arial, sans-serif; font-size: 10.5pt; color: #000; }\n  .cms-doc h1 { font-size: 15pt; margin: 0 0 2px; letter-spacing: .5px; text-transform: uppercase; }\n  .cms-doc .sub { font-size: 9pt; color: #444; margin-bottom: 10px; }\n  .cms-doc .hdr { width: 100%; border-collapse: collapse; margin-bottom: 12px; }\n  .cms-doc .hdr td { border: 1px solid #999; padding: 4px 7px; vertical-align: top; font-size: 9.5pt; }\n  .cms-doc .hdr td.k { background: #f2f2f2; font-weight: bold; width: 18%; white-space: nowrap; }\n  .cms-doc table.items { width: 100%; border-collapse: collapse; margin-bottom: 12px; }\n  .cms-doc table.items th { background: #e8e8e8; border: 1px solid #999; padding: 5px 6px; font-size: 9pt;\n      text-align: left; text-transform: uppercase; letter-spacing: .3px; }\n  .cms-doc table.items td { border: 1px solid #bbb; padding: 4px 6px; font-size: 9.5pt; vertical-align: top; }\n  .cms-doc .num { text-align: right; white-space: nowrap; }\n  .cms-doc .sec td { background: #f7f7f7; font-weight: bold; }\n  .cms-doc table.tot { width: 58%; border-collapse: collapse; float: right; margin-bottom: 10px; }\n  .cms-doc table.tot td { border: 1px solid #999; padding: 4px 7px; font-size: 9.5pt; }\n  .cms-doc table.tot td.k { background: #f2f2f2; }\n  .cms-doc table.tot tr.grand td { background: #e2e2e2; font-weight: bold; font-size: 11pt; }\n  .cms-doc .scope { border: 1px solid #999; padding: 7px 9px; margin-bottom: 12px; font-size: 9.5pt; }\n  .cms-doc .scope b { display: block; margin-bottom: 3px; text-transform: uppercase; font-size: 8.5pt; letter-spacing: .4px; }\n  .cms-doc .sign { width: 100%; border-collapse: collapse; margin-top: 26px; page-break-inside: avoid; }\n  .cms-doc .sign td { border: 1px solid #999; padding: 7px; height: 62px; vertical-align: top;\n      font-size: 8.5pt; text-transform: uppercase; letter-spacing: .4px; color: #444; width: 33.3%; }\n  .cms-doc .clear { clear: both; }\n</style>\n<div class=\"cms-doc\">\n  <h1>Variation Order</h1>\n  <div class=\"sub\">No. {{ doc.vo_number }} &mdash; {{ doc.vo_title }}</div>\n  <table class=\"hdr\">\n<tr>\n<td class=\"k\">VO No</td><td>{{ doc.name }}</td>\n<td class=\"k\">Project</td><td>{{ doc.project }}</td>\n</tr>\n<tr>\n<td class=\"k\">Client</td><td>{{ doc.client or '' }}</td>\n<td class=\"k\">Client Instruction Ref</td><td>{{ doc.client_reference or '' }}</td>\n</tr>\n<tr>\n<td class=\"k\">Type</td><td>{{ doc.variation_type }}</td>\n<td class=\"k\">Reason</td><td>{{ doc.reason }}</td>\n</tr>\n<tr>\n<td class=\"k\">Date Raised</td><td>{{ frappe.utils.formatdate(doc.date_raised) if doc.date_raised else '' }}</td>\n<td class=\"k\">Extension of Time</td><td>{{ doc.time_extension_days or 0 }} day(s)</td>\n</tr>\n</table>\n  <div class=\"scope\"><b>Scope of Change</b>{{ doc.description or \"\" }}</div>\n  <table class=\"items\">\n    <thead><tr>\n      <th style=\"width:4%\">#</th><th style=\"width:12%\">Nature</th><th style=\"width:38%\">Description</th>\n      <th style=\"width:7%\">Unit</th><th style=\"width:10%\" class=\"num\">Qty</th>\n      <th style=\"width:13%\" class=\"num\">Rate</th><th style=\"width:16%\" class=\"num\">Amount</th>\n    </tr></thead>\n    <tbody>\n    {% for row in doc.items %}\n      <tr>\n        <td>{{ row.idx }}</td>\n        <td>{{ row.nature }}</td>\n        <td>{{ row.description }}</td>\n        <td>{{ row.uom or \"\" }}</td>\n        <td class=\"num\">{{ \"{:,.2f}\".format(row.qty or 0) }}</td>\n        <td class=\"num\">{{ row.get_formatted(\"rate\") }}</td>\n        <td class=\"num\">{{ row.get_formatted(\"amount\") }}</td>\n      </tr>\n    {% endfor %}\n    </tbody>\n  </table>\n  <table class=\"tot\">\n    <tr><td class=\"k\">Additions</td><td class=\"num\">{{ doc.get_formatted(\"addition_amount\") }}</td></tr>\n    <tr><td class=\"k\">Omissions</td><td class=\"num\">({{ doc.get_formatted(\"omission_amount\") }})</td></tr>\n    <tr class=\"grand\"><td class=\"k\">Net Variation</td><td class=\"num\">{{ doc.get_formatted(\"net_variation_amount\") }}</td></tr>\n    <tr><td class=\"k\">Original Contract Value</td><td class=\"num\">{{ doc.get_formatted(\"original_contract_value\") }}</td></tr>\n    <tr><td class=\"k\">Previously Approved Variations</td><td class=\"num\">{{ doc.get_formatted(\"previous_variations_amount\") }}</td></tr>\n    <tr class=\"grand\"><td class=\"k\">Revised Contract Value</td><td class=\"num\">{{ doc.get_formatted(\"revised_contract_value\") }}</td></tr>\n  </table>\n  <div class=\"clear\"></div>\n  <table class=\"sign\">\n  <tr><td>Requested by (Contractor)</td><td>Recommended by (Engineer)</td><td>Approved by (Employer)</td></tr>\n</table>\n</div>",
 "idx": 0,
 "line_breaks": 0,
