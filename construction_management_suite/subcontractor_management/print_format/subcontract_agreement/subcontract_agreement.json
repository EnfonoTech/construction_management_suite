 "doctype": "Print Format",
 "font_size": 0,
 "html": "<style>\n  .cms-doc { font-family: \"Helvetica Neue\", Arial, sans-serif; font-size: 10.5pt; color: #000; }\n  .cms-doc h1 { font-size: 15pt; margin: 0 0 2px; letter-spacing: .5px; text-transform: uppercase; }\n  .cms-doc .sub { font-size: 9pt; color: #444; margin-bottom: 10px; }\n  .cms-doc .hdr { width: 100%; border-collapse: collapse; margin-bottom: 12px; }\n  .cms-doc .hdr td { border: 1px solid #999; padding: 4px 7px; vertical-align: top; font-size: 9.5pt; }\n  .cms-doc .hdr td.k { background: #f2f2f2; font-weight: bold; width: 18%; white-space: nowrap; }\n  .cms-doc table.items { width: 100%; border-collapse: collapse; margin-bottom: 12px; }\n  .cms-doc table.items th { background: #e8e8e8; border: 1px solid #999; padding: 5px 6px; font-size: 9pt;\n      text-align: left; text-transform: uppercase; letter-spacing: .3px; }\n  .cms-doc table.items td { border: 1px solid #bbb; padding: 4px 6px; font-size: 9.5pt; vertical-align: top; }\n  .cms-doc .num { text-align: right; white-space: nowrap; }\n  .cms-doc .sec td { background: #f7f7f7; font-weight: bold; }\n  .cms-doc table.tot { width: 58%; border-collapse: collapse; float: right; margin-bottom: 10px; }\n  .cms-doc table.tot td { border: 1px solid #999; padding: 4px 7px; font-size: 9.5pt; }\n  .cms-doc table.tot td.k { background: #f2f2f2; }\n  .cms-doc table.tot tr.grand td { background: #e2e2e2; font-weight: bold; font-size: 11pt; }\n  .cms-doc .scope { border: 1px solid #999; padding: 7px 9px; margin-bottom: 12px; font-size: 9.5pt; }\n  .cms-doc .scope b { display: block; margin-bottom: 3px; text-transform: uppercase; font-size: 8.5pt; letter-spacing: .4px; }\n  .cms-doc .sign { width: 100%; border-collapse: collapse; margin-top: 26px; page-break-inside: avoid; }\n  .cms-doc .sign td { border: 1px solid #999; padding: 7px; height: 62px; vertical-align: top;\n      font-size: 8.5pt; text-transform: uppercase; letter-spacing: .4px; color: #444; width: 33.3%; }\n  .cms-doc .clear { clear: both; }\n</style>\n<div class=\"cms-doc\">\n  <h1>Subcontract Agreement</h1>\n  <div class=\"sub\">{{ doc.agreement_title }}</div>\n  <table class=\"hdr\">\n<tr>\n<td class=\"k\">Agreement No</td><td>{{ doc.name }}</td>\n<td class=\"k\">Project</td><td>{{ doc.project }}</td>\n</tr>\n<tr>\n<td class=\"k\">Subcontractor</td><td>{{ doc.subcontractor }}</td>\n<td class=\"k\">Contract Date</td><td>{{ frappe.utils.formatdate(doc.contract_date) if doc.contract_date else '' }}</td>\n</tr>\n<tr>\n<td class=\"k\">Start Date</td><td>{{ frappe.utils.formatdate(doc.start_date) if doc.start_date else '' }}</td>\n<td class=\"k\">End Date</td><td>{{ frappe.utils.formatdate(doc.end_date) if doc.end_date else '' }}</td>\n</tr>\n<tr>\n<td class=\"k\">Retention</td><td>{{ doc.retention_percent or 0 }}%</td>\n<td class=\"k\">Defects Liability</td><td>{{ doc.defects_liability_days or 0 }} day(s)</td>\n</tr>\n</table>\n  {% if doc.scope_of_work %}<div class=\"scope\"><b>Scope of Work</b>{{ doc.scope_of_work }}</div>{% endif %}\n  <table class=\"items\">\n    <thead><tr>\n      <th style=\"width:4%\">#</th><th style=\"width:48%\">Description</th><th style=\"width:8%\">Unit</th>\n      <th style=\"width:11%\" class=\"num\">Qty</th><th style=\"width:13%\" class=\"num\">Rate</th>\n      <th style=\"width:16%\" class=\"num\">Amount</th>\n    </tr></thead>\n    <tbody>\n    {% for row in doc.items %}\n      <tr>\n        <td>{{ row.idx }}</td>\n        <td>{{ row.description }}</td>\n        <td>{{ row.uom or \"\" }}</td>\n        <td class=\"num\">{{ \"{:,.2f}\".format(row.qty or 0) }}</td>\n        <td class=\"num\">{{ row.get_formatted(\"rate\") }}</td>\n        <td class=\"num\">{{ row.get_formatted(\"amount\") }}</td>\n      </tr>\n    {% endfor %}\n    </tbody>\n  </table>\n  <table class=\"tot\">\n    <tr class=\"grand\"><td class=\"k\">Subcontract Value</td><td class=\"num\">{{ doc.get_formatted(\"subcontract_value\") }}</td></tr>\n    <tr><td class=\"k\">Advance ({{ doc.advance_percent or 0 }}%)</td><td class=\"num\">{{ doc.get_formatted(\"advance_amount\") }}</td></tr>\n    <tr><td class=\"k\">Performance Bond</td><td class=\"num\">{{ doc.performance_bond_percent or 0 }}%</td></tr>\n  </table>\n  <div class=\"clear\"></div>\n  <table class=\"sign\">\n  <tr><td>For the Contractor</td><td>For the Subcontractor</td><td>Witness</td></tr>\n</table>\n</div>",
 "idx": 0,
 "line_breaks": 0,
