 "doctype": "Print Format",
 "font_size": 0,
 "html": "<style>\n  .cms-doc { font-family: \"Helvetica Neue\", Arial, sans-serif; font-size: 10.5pt; color: #000; }\n  .cms-doc h1 { font-size: 15pt; margin: 0 0 2px; letter-spacing: .5px; text-transform: uppercase; }\n  .cms-doc .sub { font-size: 9pt; color: #444; margin-bottom: 10px; }\n  .cms-doc .hdr { width: 100%; border-collapse: collapse; margin-bottom: 12px; }\n  .cms-doc .hdr td { border: 1px solid #999; padding: 4px 7px; vertical-align: top; font-size: 9.5pt; }\n  .cms-doc .hdr td.k { background: #f2f2f2; font-weight: bold; width: 18%; white-space: nowrap; }\n  .cms-doc table.items { width: 100%; border-collapse: collapse; margin-bottom: 12px; }\n  .cms-doc table.items th { background: #e8e8e8; border: 1px solid #999; padding: 5px 6px; font-size: 9pt;\n      text-align: left; text-transform: uppercase; letter-spacing: .3px; }\n  .cms-doc table.items td { border: 1px solid #bbb; padding: 4px 6px; font-size: 9.5pt; vertical-align: top; }\n  .cms-doc .num { text-align: right; white-space: nowrap; }\n  .cms-doc .sec td { background: #f7f7f7; font-weight: bold; }\n  .cms-doc table.tot { width: 58%; border-collapse: collapse; float: right; margin-bottom: 10px; }\n  .cms-doc table.tot td { border: 1px solid #999; padding: 4px 7px; font-size: 9.5pt; }\n  .cms-doc table.tot td.k { background: #f2f2f2; }\n  .cms-doc table.tot tr.grand td { background: #e2e2e2; font-weight: bold; font-size: 11pt; }\n  .cms-doc .scope { border: 1px solid #999; padding: 7px 9px; margin-bottom: 12px; font-size: 9.5pt; }\n  .cms-doc .scope b { display: block; margin-bottom: 3px; text-transform: uppercase; font-size: 8.5pt; letter-spacing: .4px; }\n  .cms-doc .sign { width: 100%; border-collapse: collapse; margin-top: 26px; page-break-inside: avoid; }\n  .cms-doc .sign td { border: 1px solid #999; padding: 7px; height: 62px; vertical-align: top;\n      font-size: 8.5pt; text-transform: uppercase; letter-spacing: .4px; color: #444; width: 33.3%; }\n  .cms-doc .clear { clear: both; }\n</style>\n<div class=\"cms-doc\">\n  <h1>Subcontractor Payment Certificate</h1>\n  <div class=\"sub\">{{ doc.certificate_title }}</div>\n  <table class=\"hdr\">\n<tr>\n<td class=\"k\">Certificate No</td><td>{{ doc.name }}</td>\n<td class=\"k\">Subcontract</td><td>{{ doc.subcontract_agreement }}</td>\n</tr>\n<tr>\n<td class=\"k\">Subcontractor</td><td>{{ doc.subcontractor }}</td>\n<td class=\"k\">Project</td><td>{{ doc.project or '' }}</td>\n</tr>\n<tr>\n<td class=\"k\">Date</td><td>{{ frappe.utils.formatdate(doc.submission_date) if doc.submission_date else '' }}</td>\n<td class=\"k\">Currency</td><td>{{ doc.currency }}</td>\n</tr>\n</table>\n  <table class=\"items\">\n    <thead><tr>\n      <th style=\"width:5%\">#</th><th style=\"width:70%\">Description</th>\n      <th style=\"width:25%\" class=\"num\">Amount Claimed</th>\n    </tr></thead>\n    <tbody>\n    {% for row in doc.items %}\n      <tr>\n        <td>{{ row.idx }}</td>\n        <td>{{ row.description }}</td>\n        <td class=\"num\">{{ row.get_formatted(\"amount_claimed\") }}</td>\n      </tr>\n    {% endfor %}\n    </tbody>\n  </table>\n  <table class=\"tot\">\n    <tr><td class=\"k\">Gross Amount Claimed</td><td class=\"num\">{{ doc.get_formatted(\"gross_amount_claimed\") }}</td></tr>\n    <tr><td class=\"k\">Amount Certified</td><td class=\"num\">{{ doc.get_formatted(\"certified_amount\") }}</td></tr>\n    <tr><td class=\"k\">Less Retention ({{ doc.retention_percent or 0 }}%)</td><td class=\"num\">({{ doc.get_formatted(\"retention_deduction\") }})</td></tr>\n    {% if doc.advance_recovery %}\n    <tr><td class=\"k\">Less Advance Recovery</td><td class=\"num\">({{ doc.get_formatted(\"advance_recovery\") }})</td></tr>\n    {% endif %}\n    {% if doc.other_deductions %}\n    <tr><td class=\"k\">Less Other Deductions</td><td class=\"num\">({{ doc.get_formatted(\"other_deductions\") }})</td></tr>\n    {% endif %}\n    <tr class=\"grand\"><td class=\"k\">Net Payable</td><td class=\"num\">{{ doc.get_formatted(\"net_payable\") }}</td></tr>\n  </table>\n  <div class=\"clear\"></div>\n  <table class=\"sign\">\n  <tr><td>Claimed by (Subcontractor)</td><td>Certified by (Engineer)</td><td>Approved by (Contractor)</td></tr>\n</table>\n</div>",
 "idx": 0,
 "line_breaks": 0,
